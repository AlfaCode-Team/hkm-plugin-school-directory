{
    "name": "alfacode-team/hkm-plugin-school-directory",
    "description": "The school registry: schools, per-school settings, privacy flags, status guard and the school year. Exposes SchoolScope.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolDirectory\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolDirectory\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
